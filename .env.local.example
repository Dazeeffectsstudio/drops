# Copie ce fichier en .env.local (ignoré par git) et renseigne tes propres
# valeurs depuis le tableau de bord Supabase : Project Settings > API.

# URL du projet Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique "anon" (Project Settings > API > anon public)
# Sans risque à exposer au navigateur : elle ne peut que lire les offres.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service role" (Project Settings > API > service_role secret)
# NE JAMAIS exposer au navigateur. Utilisée uniquement côté serveur par le
# dashboard /admin pour ajouter/modifier/supprimer des offres.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — protège la route /api/sync (voir src/app/api/sync/route.ts).
# Sans cette valeur, /api/sync reste accessible sans secret. Une fois
# définie, tout appel doit inclure l'en-tête
# "Authorization: Bearer <valeur>". Choisis une chaîne longue et aléatoire.
SYNC_SECRET=

# Liste des emails autorisés à accéder à /admin et /admin/sync (séparés par
# des virgules, ex: "toi@example.com,associe@example.com"). IMPORTANT : dès
# que Supabase Auth est actif, /admin se ferme à tout le monde SAUF ces
# adresses — ajoute-toi ici avant de déployer, sinon tu seras bloqué·e hors
# de ton propre tableau de bord. Si Supabase n'est pas configuré du tout,
# /admin reste ouvert comme avant (développement local uniquement).
ADMIN_EMAILS=

# Pour activer la connexion Google/GitHub : dans le tableau de bord
# Supabase, va dans Authentication > Providers, active Google et/ou GitHub,
# et renseigne les identifiants OAuth créés depuis Google Cloud Console /
# GitHub Developer Settings (callback URL à donner : celle affichée par
# Supabase sur cette même page). La connexion par email/mot de passe
# fonctionne sans aucune configuration supplémentaire.
